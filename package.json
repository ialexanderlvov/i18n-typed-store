{
	"name": "i18n-typed-store",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"prepare": "husky",
		"nx": "NODE_OPTIONS='--no-deprecation' nx",
		"build": "NODE_OPTIONS='--no-deprecation' nx run-many -t build --all",
		"test": "NODE_OPTIONS='--no-deprecation' nx run-many -t test --all",
		"test:coverage": "NODE_OPTIONS='--no-deprecation' nx run-many -t test:coverage --all",
		"lint": "NODE_OPTIONS='--no-deprecation' nx run-many -t lint --all",
		"affected:build": "NODE_OPTIONS='--no-deprecation' nx affected -t build",
		"affected:test": "NODE_OPTIONS='--no-deprecation' nx affected -t test",
		"affected:test:coverage": "NODE_OPTIONS='--no-deprecation' nx affected -t test:coverage",
		"affected:lint": "NODE_OPTIONS='--no-deprecation' nx affected -t lint",
		"graph": "NODE_OPTIONS='--no-deprecation' nx graph",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
		"changeset": "changeset",
		"changeset:version": "changeset version && pnpm install --no-frozen-lockfile && pnpm format",
		"changeset:publish": "changeset publish",
		"prepublish:build": "pnpm build",
		"prepublish:test": "pnpm test",
		"prepublish:lint": "pnpm lint",
		"prepublish:format": "pnpm format:check",
		"prepublish": "pnpm prepublish:build && pnpm prepublish:test && pnpm prepublish:lint && pnpm prepublish:format",
		"publish:version": "pnpm prepublish && pnpm changeset:version",
		"publish:release": "pnpm prepublish && pnpm changeset:publish"
	},
	"author": "Alexander Lvov",
	"license": "MIT",
	"packageManager": "pnpm@10.28.0",
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@eslint/js": "^9.39.2",
		"@eslint/json": "^0.14.0",
		"@eslint/markdown": "^7.5.1",
		"@nx/eslint": "^22.3.3",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.0.8",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.39.2",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"jsdom": "^27.4.0",
		"lint-staged": "^16.2.7",
		"nx": "22.3.3",
		"prettier": "^3.9.4",
		"react-dom": "^19.2.7",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.62.1",
		"vitest": "^4.1.9"
	}
}
