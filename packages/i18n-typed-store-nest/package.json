{
	"name": "i18n-typed-store-nest",
	"version": "0.5.1",
	"description": "NestJS module for i18n-typed-store — request-scoped type-safe translations with locale detection",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"lint": "eslint .",
		"type-check": "tsc --project tsconfig.test.json",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"clean": "rm -rf dist"
	},
	"keywords": [
		"i18n",
		"nestjs",
		"nest",
		"i18n-nestjs",
		"internationalization",
		"localization",
		"locale",
		"translation",
		"typescript",
		"type-safe",
		"typed",
		"store",
		"translations"
	],
	"author": "Alexander Lvov",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ialexanderlvov/i18n-typed-store.git",
		"directory": "packages/i18n-typed-store-nest"
	},
	"homepage": "https://github.com/ialexanderlvov/i18n-typed-store/tree/main/packages/i18n-typed-store-nest#readme",
	"bugs": {
		"url": "https://github.com/ialexanderlvov/i18n-typed-store/issues"
	},
	"license": "MIT",
	"type": "commonjs",
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
		"@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
		"express": "^4.0.0 || ^5.0.0",
		"i18n-typed-store": ">=0.6.0 <1",
		"rxjs": "^7.0.0"
	},
	"peerDependenciesMeta": {
		"express": {
			"optional": true
		}
	},
	"devDependencies": {
		"@nestjs/common": "^12.0.1",
		"@nestjs/core": "^12.0.1",
		"@nestjs/platform-express": "^12.0.1",
		"@nestjs/testing": "^12.0.1",
		"@types/express": "^5.0.6",
		"@vitest/coverage-v8": "4.1.11",
		"express": "^5.2.1",
		"i18n-typed-store": "workspace:*",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"vitest": "4.1.11"
	}
}
