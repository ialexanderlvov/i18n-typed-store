{
	"name": "i18n-typed-store",
	"version": "0.5.1",
	"description": "Type-safe translation store for managing i18n locales with full TypeScript support",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"lint": "eslint .",
		"type-check": "tsc --project tsconfig.test.json",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"clean": "rm -rf dist"
	},
	"keywords": [
		"i18n",
		"internationalization",
		"localization",
		"locale",
		"translation",
		"typescript",
		"type-safe",
		"typed",
		"store",
		"translations"
	],
	"author": "Alexander Lvov",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ialexanderlvov/i18n-typed-store.git",
		"directory": "packages/i18n-typed-store"
	},
	"homepage": "https://github.com/ialexanderlvov/i18n-typed-store/tree/main/packages/i18n-typed-store#readme",
	"bugs": {
		"url": "https://github.com/ialexanderlvov/i18n-typed-store/issues"
	},
	"license": "MIT",
	"type": "commonjs",
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "4.1.11",
		"vitest": "4.1.11"
	}
}
