{
	"name": "i18n-typed-store-react",
	"version": "0.5.1",
	"description": "React bindings for i18n-typed-store — type-safe translations with hooks, Suspense and SSR support",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./server": {
			"import": {
				"types": "./dist/server.d.mts",
				"default": "./dist/server.mjs"
			},
			"require": {
				"types": "./dist/server.d.ts",
				"default": "./dist/server.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"lint": "eslint .",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"clean": "rm -rf dist"
	},
	"keywords": [
		"i18n",
		"react",
		"i18n-react",
		"internationalization",
		"localization",
		"locale",
		"translation",
		"typescript",
		"type-safe",
		"typed",
		"store",
		"translations"
	],
	"author": "Alexander Lvov",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ialexanderlvov/i18n-typed-store.git",
		"directory": "packages/i18n-typed-store-react"
	},
	"homepage": "https://github.com/ialexanderlvov/i18n-typed-store/tree/main/packages/i18n-typed-store-react#readme",
	"bugs": {
		"url": "https://github.com/ialexanderlvov/i18n-typed-store/issues"
	},
	"license": "MIT",
	"type": "commonjs",
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"i18n-typed-store": "workspace:*"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.2.17",
		"@vitest/coverage-v8": "4.1.9",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	}
}
